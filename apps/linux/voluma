        def _build_partition_row(self, node: DiskNode) -> Gtk.Widget:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            nlbl = Gtk.Label(xalign=0)
            nlbl.set_markup(f"<b>{GLib.markup_escape_text(node.title)}</b>")
            badge = Gtk.Label(label=node.kind_label)
            badge.get_style_context().add_class("voluma-badge")
            title_box.pack_start(nlbl, False, False, 0)
            title_box.pack_start(badge, False, False, 0)
            left.pack_start(title_box, False, False, 0)

            sub = f"{node.path} · {node.mount_path or 'Not mounted'} · {format_bytes(node.size)}"
            slbl = Gtk.Label(label=sub, xalign=0)
            slbl.set_opacity(0.7)
            left.pack_start(slbl, False, False, 0)
            row.pack_start(left, True, True, 0)

            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            if node.is_mounted and node.total and node.total > 0:
                free = node.free or 0
                cap_lbl = Gtk.Label(label=f"{format_bytes(free)} available of {format_bytes(node.total)}", xalign=1)
                cap_lbl.set_opacity(0.75)
                bar = Gtk.ProgressBar()
                bar.set_fraction(max(0.0, min(1.0, 1.0 - float(free) / float(node.total))))
                bar.set_size_request(260, -1)
                right.pack_start(cap_lbl, False, False, 0)
                right.pack_start(bar, False, False, 0)

            btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            if node.is_mounted:
                b_browse = Gtk.Button(label="Browse")
                b_browse.connect("clicked", lambda *_, n=node: self.open_mounted_volume(n))
                btns.pack_start(b_browse, False, False, 0)

                b_lens = Gtk.Button(label="Storage Lens")
                b_lens.connect("clicked", lambda *_, n=node: self.start_lens_scan(n.mount_path, n.title))
                btns.pack_start(b_lens, False, False, 0)

                b_files = Gtk.Button(label="Show in Files")
                b_files.connect("clicked", lambda *_, mp=node.mount_path: subprocess.Popen(["xdg-open", mp]))
                btns.pack_start(b_files, False, False, 0)
            elif node.raw_browsable:
                b_raw = Gtk.Button(label="Browse Raw…")
                b_raw.connect("clicked", lambda *_, n=node: self.open_raw_partition(n))
                btns.pack_start(b_raw, False, False, 0)

            right.pack_start(btns, False, False, 0)
            row.pack_end(right, False, False, 0)
            return row

