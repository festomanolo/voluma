                    "Writing through VOLUMA's driver (volume unmounted from OS until you finish)."
                    if can_write
                    else (f"Read-only: {write_blocked}" if write_blocked else "Reading through VOLUMA's raw driver (read-only).")
                )
                banner.pack_start(Gtk.Label(label=msg, xalign=0), True, True, 0)
                fin_btn = Gtk.Button(label="Close" if b.get("raw_only") else "Finish & Remount")
                fin_btn.connect("clicked", lambda *_: self.on_nav_back())
                banner.pack_end(fin_btn, False, False, 0)
                self.browser_container.pack_start(banner, False, False, 0)

            if err_msg:
                lbl = Gtk.Label(label=f"Cannot read folder: {err_msg}")
                self.browser_container.pack_start(lbl, True, True, 20)
                self.browser_container.show_all()
                return

            # Table (TreeView)
            store = Gtk.ListStore(str, str, str, str, object)
            entries = (listing or {}).get("entries", [])
            for e in entries:
                is_dir = e.get("kind") == "directory"
                sz_txt = "—" if is_dir else format_bytes(int(e.get("size") or 0))
                mtime = e.get("modified")
                mod_txt = (
                    datetime.datetime.fromtimestamp(int(mtime)).strftime("%Y-%m-%d %H:%M")
                    if mtime
                    else "—"
                )
                icon = "folder-symbolic" if is_dir else "text-x-generic-symbolic"
                store.append([icon, e["name"], sz_txt, mod_txt, e])

            tv = Gtk.TreeView(model=store)
