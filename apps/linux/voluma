#!/usr/bin/env python3
"""
VOLUMA for Linux (Light OS / GTK 3).
Reads and writes NTFS, exFAT, and FAT12/16/32, and browses ext2/3/4, APFS, and HFS+
through the Rust `libvoluma_ffi` C ABI and the privileged `voluma-helper` daemon.
"""

import argparse
import ctypes
import datetime
import json
import os
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from pathlib import Path

__version__ = "0.1.1"


def format_bytes(n: int) -> str:
    if n is None or n < 0:
        return "0 B"
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    val = float(n)
    idx = 0
    while val >= 1000.0 and idx < len(units) - 1:
        val /= 1000.0
        idx += 1
    if idx == 0:
        return f"{int(val)} B"
    return f"{val:.1f} {units[idx]}"


def join_path(a: str, b: str) -> str:
    if not a or a == "/":
        return "/" + b.lstrip("/")
    return a.rstrip("/") + "/" + b.lstrip("/")


# ---------------------------------------------------------------------------
# Rust Engine C-ABI Wrapper (libvoluma_ffi)
# ---------------------------------------------------------------------------

class EngineError(Exception):
    pass


class Engine:
    _lib = None
    _lock = threading.Lock()

    @classmethod
    def _load(cls):
        if cls._lib is not None:
            return cls._lib
        with cls._lock:
            if cls._lib is not None:
                return cls._lib
            here = Path(__file__).resolve().parent
            repo = here.parent.parent
            candidates = []
            if os.environ.get("VOLUMA_FFI_LIB"):
                candidates.append(Path(os.environ["VOLUMA_FFI_LIB"]))
            for ext in ("so", "dylib"):
                candidates.extend([
                    here / f"libvoluma_ffi.{ext}",
                    Path(f"/usr/local/lib/voluma/libvoluma_ffi.{ext}"),
                    Path(f"/usr/lib64/voluma/libvoluma_ffi.{ext}"),
                    Path(f"/usr/lib/voluma/libvoluma_ffi.{ext}"),
                    repo / "target" / "release" / f"libvoluma_ffi.{ext}",
                    repo / "target" / "debug" / f"libvoluma_ffi.{ext}",
                ])
            lib_path = next((p for p in candidates if p.is_file()), None)
            if lib_path is None:
                raise EngineError(
                    "libvoluma_ffi shared library not found. Build it with apps/linux/build.sh."
                )
            lib = ctypes.CDLL(str(lib_path))

            lib.voluma_inspect_image.argtypes = [ctypes.c_char_p]
            lib.voluma_inspect_image.restype = ctypes.c_void_p

            lib.voluma_list_directory.argtypes = [ctypes.c_char_p, ctypes.c_int32, ctypes.c_char_p]
            lib.voluma_list_directory.restype = ctypes.c_void_p

            lib.voluma_mutate.argtypes = [
                ctypes.c_char_p,
                ctypes.c_int32,
                ctypes.c_char_p,
                ctypes.c_char_p,
                ctypes.c_char_p,
                ctypes.c_int32,
            ]
            lib.voluma_mutate.restype = ctypes.c_void_p

            lib.voluma_export_file.argtypes = [
                ctypes.c_char_p,
                ctypes.c_int32,
                ctypes.c_char_p,
                ctypes.c_char_p,
            ]
            lib.voluma_export_file.restype = ctypes.c_void_p

            lib.voluma_free_string.argtypes = [ctypes.c_void_p]
            lib.voluma_free_string.restype = None

            cls._lib = lib
            return lib

    @classmethod
    def _call(cls, ptr: int):
        if not ptr:
            raise EngineError("Null response from voluma-ffi")
        try:
            raw = ctypes.cast(ptr, ctypes.c_char_p).value
            data = json.loads(raw.decode("utf-8", errors="replace"))
        finally:
            cls._load().voluma_free_string(ptr)
        if "error" in data and data["error"] is not None:
            raise EngineError(str(data["error"]))
        if "ok" not in data:
            raise EngineError("Malformed engine response")
        return data["ok"]

    @classmethod
    def inspect_image(cls, path: str) -> dict:
        lib = cls._load()
        return cls._call(lib.voluma_inspect_image(path.encode("utf-8")))

    @classmethod
    def list_directory(cls, image: str, part: int, path: str) -> dict:
        lib = cls._load()
        return cls._call(
            lib.voluma_list_directory(image.encode("utf-8"), int(part), path.encode("utf-8"))
        )

    @classmethod
    def mutate(cls, image: str, part: int, op: str, a: str, b: str = "", overwrite: bool = False) -> dict:
        lib = cls._load()
        return cls._call(
            lib.voluma_mutate(
                image.encode("utf-8"),
                int(part),
                op.encode("utf-8"),
                a.encode("utf-8"),
                b.encode("utf-8"),
                1 if overwrite else 0,
            )
        )

    @classmethod
    def export_file(cls, image: str, part: int, fs_path: str, dest: str) -> dict:
        lib = cls._load()
        return cls._call(
            lib.voluma_export_file(
                image.encode("utf-8"),
                int(part),
                fs_path.encode("utf-8"),
                dest.encode("utf-8"),
            )
        )


# ---------------------------------------------------------------------------
# Privileged Helper Session (voluma-helper over Unix socket)
# ---------------------------------------------------------------------------

class HelperSession:
    def __init__(self, device: str, title: str, stage: Path, was_mounted: bool = False):
        self.device = device
        self.title = title
        self.stage = stage
        self.was_mounted = was_mounted
        self._sock = None
        self._rfile = None
        self._lock = threading.Lock()

    @staticmethod
    def locate_helper() -> Path:
        here = Path(__file__).resolve().parent
        repo = here.parent.parent
        candidates = []
        if os.environ.get("VOLUMA_HELPER"):
            candidates.append(Path(os.environ["VOLUMA_HELPER"]))
        candidates.extend([
            here / "voluma-helper",
            Path("/usr/local/bin/voluma-helper"),
            Path("/usr/bin/voluma-helper"),
            repo / "target" / "release" / "voluma-helper",
            repo / "target" / "debug" / "voluma-helper",
        ])
        for c in candidates:
            if c.is_file() and os.access(str(c), os.X_OK):
                return c
        raise EngineError("voluma-helper binary not found. Build it with apps/linux/build.sh.")

    def connect(self):
        sock_path = self.stage / "helper.sock"
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(str(sock_path))
        self._sock = s
        self._rfile = s.makefile("r", encoding="utf-8")

    def call_ok(self, payload: dict):
        with self._lock:
            if self._sock is None:
                raise EngineError("Helper session is closed")
            line = json.dumps(payload) + "\n"
            self._sock.sendall(line.encode("utf-8"))
            reply = self._rfile.readline()
            if not reply:
                raise EngineError("Lost connection to voluma-helper")
            env = json.loads(reply)
            if "error" in env and env["error"] is not None:
                raise EngineError(str(env["error"]))
            return env.get("ok")

    def close(self):
        with self._lock:
            if self._sock is not None:
                try:
                    self._sock.sendall(b'{"op":"quit"}\n')
                    self._rfile.readline()
                except Exception:
                    pass
                try:
                    self._sock.close()
                except Exception:
                    pass
                self._sock = None
                self._rfile = None
        shutil.rmtree(str(self.stage), ignore_errors=True)


class HelperSessions:
    _active = {}

    @classmethod
    def get(cls, device: str):
        return cls._active.get(device)

    @classmethod
    def start(cls, device: str, title: str, mounted: bool = False, check_write: bool = False) -> HelperSession:
        if device in cls._active:
            return cls._active[device]
        helper = HelperSession.locate_helper()
        stage = Path(tempfile.mkdtemp(prefix="voluma-")).resolve()
        os.chmod(str(stage), 0o700)

        if mounted:
            err = DiskOps.unmount(device)
            if err:
                shutil.rmtree(str(stage), ignore_errors=True)
                raise EngineError(f"Could not unmount {device}: {err}")

        session = HelperSession(device=device, title=title, stage=stage, was_mounted=mounted)
        try:
            direct = os.geteuid() == 0 or os.access(device, os.R_OK | (os.W_OK if check_write else os.R_OK))
            args = [
                str(helper),
                "serve",
                "--device",
                device,
                "--stage",
                str(stage),
                "--uid",
                str(os.getuid()),
                "--parent",
                str(os.getpid()),
            ]
            log_path = stage / "helper.log"
            log_file = open(str(log_path), "w")
            if direct:
                subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=log_file)
            else:
                sh_cmd = (
                    f"'{helper}' serve --device '{device}' --stage '{stage}' "
                    f"--uid {os.getuid()} --parent {os.getpid()} >/dev/null 2>'{log_path}' &"
                )
                if shutil.which("pkexec"):
                    rc = subprocess.call(["pkexec", "sh", "-c", sh_cmd])
                elif os.path.isfile("/opt/porteus-scripts/xorg/psu"):
                    rc = subprocess.call(["/opt/porteus-scripts/xorg/psu", "sh", "-c", sh_cmd])
                else:
                    rc = subprocess.call(["sudo", "-n", "sh", "-c", sh_cmd])
                if rc != 0:
                    raise EngineError("Administrator privileges were not granted.")

            sock_path = stage / "helper.sock"
            for _ in range(100):
                if sock_path.exists():
                    break
                time.sleep(0.05)
            else:
                err_txt = ""
                try:
                    err_txt = log_path.read_text(encoding="utf-8", errors="replace").strip()
                except Exception:
                    pass
                raise EngineError("voluma-helper did not start" + (f": {err_txt}" if err_txt else "."))

            session.connect()
            session.call_ok({"op": "ping"})
            first = session.call_ok({"op": "list", "path": "/"})
            if check_write and first.get("write_blocked"):
                raise EngineError(f"Cannot write safely: {first['write_blocked']}")
        except Exception:
            session.close()
            if mounted:
                DiskOps.mount(device)
            raise

        cls._active[device] = session
        return session

    @classmethod
    def end(cls, device: str):
        s = cls._active.pop(device, None)
        if not s:
            return None
        was_mounted = s.was_mounted
        s.close()
        if was_mounted:
            return DiskOps.mount(device)
        return None

    @classmethod
    def end_all(cls):
        for dev in list(cls._active.keys()):
            cls.end(dev)


