CATEGORIES = [
    ("Applications", "#3b82f6"),
    ("Documents", "#f97316"),
    ("Images", "#22c55e"),
    ("Video", "#a855f7"),
    ("Audio", "#ec4899"),
    ("Archives", "#a16207"),
    ("Developer", "#14b8a6"),
    ("System & Library", "#6b7280"),
    ("Other", "#9ca3af"),
]

EXT_CATEGORY = {}
for _idx, _exts in enumerate([
    {"app", "desktop", "flatpak", "snap", "appimage", "xzm"},
    {"pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "rtf", "md", "csv", "epub", "odt", "ods"},
    {"jpg", "jpeg", "png", "gif", "heic", "heif", "tif", "tiff", "bmp", "webp", "raw", "svg", "psd", "ico"},
    {"mov", "mp4", "m4v", "avi", "mkv", "wmv", "webm", "mpg", "mpeg"},
    {"mp3", "m4a", "aac", "wav", "aiff", "flac", "ogg"},
    {"zip", "gz", "tgz", "bz2", "xz", "7z", "rar", "tar", "dmg", "iso", "pkg", "img", "zst"},
    {"rs", "py", "c", "h", "cpp", "js", "ts", "tsx", "jsx", "java", "go", "rb", "php", "html", "css", "json", "xml", "yml", "yaml", "sh", "o", "a", "so", "rlib", "wasm"},
    {"conf", "db", "sqlite", "log", "cache", "dat", "bin", "tmp", "ko"},
]):
    for _e in _exts:
        EXT_CATEGORY[_e] = _idx


def classify_file(name: str, systemish: bool) -> int:
    dot = name.rfind(".")
    ext = name[dot + 1:].lower() if dot > 0 else ""
    cat = EXT_CATEGORY.get(ext, 8)
    if cat == 8 and systemish:
        return 7
    return cat


class FolderNode:
    def __init__(self, name: str, path: str, parent=None):
        self.name = name
        self.path = path
        self.parent = parent
        self.size = 0
        self.item_count = 0
        self.cats = [0] * len(CATEGORIES)
        self.children = []
        self.files = []
        self.omitted_files = 0
        self.omitted_bytes = 0
        self.unreadable = False


class StorageScanner:
    SKIP_ROOT = {"/proc", "/sys", "/dev", "/run", "/mnt/live"}
    KEPT_FILES = 100

    @classmethod
    def scan(cls, root_path: str, cancel_event: threading.Event = None, progress_cb=None) -> dict:
        t0 = time.monotonic()
        root_path = os.path.abspath(root_path)
        try:
            root_dev = os.stat(root_path, follow_symlinks=False).st_dev
        except OSError:
            root_dev = None
        seen_inodes = set()
        unreadable_count = 0
        total_files_seen = 0
        total_bytes_seen = 0

        root_node = FolderNode(os.path.basename(root_path) or root_path, root_path)

        def walk(node: FolderNode, systemish: bool):
            nonlocal unreadable_count, total_files_seen, total_bytes_seen
            if cancel_event and cancel_event.is_set():
                return
            if progress_cb and (total_files_seen & 255 == 0):
                progress_cb(total_files_seen, total_bytes_seen, node.path)
            try:
                it = os.scandir(node.path)
            except OSError:
                node.unreadable = True
                unreadable_count += 1
                return

            local_files = []
            with it:
                for de in it:
                    if cancel_event and cancel_event.is_set():
                        break
                    full = os.path.join(node.path, de.name)
                    if node.path == "/" and full in cls.SKIP_ROOT:
                        continue
                    try:
                        st = de.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        if root_dev is not None and st.st_dev != root_dev and node.path != "/":
                            continue
                        is_sys = systemish or full.startswith(("/usr", "/lib", "/lib64", "/etc", "/var", "/opt"))
                        child = FolderNode(de.name, full, parent=node)
                        node.children.append(child)
                        walk(child, is_sys)
                    elif stat.S_ISREG(st.st_mode):
                        size = int(getattr(st, "st_blocks", 0) * 512) or int(st.st_size)
                        if st.st_nlink > 1:
                            key = (st.st_dev, st.st_ino)
                            if key in seen_inodes:
                                size = 0
                            else:
                                seen_inodes.add(key)
                        cat = classify_file(de.name, systemish)
                        node.cats[cat] += size
                        node.size += size
                        node.item_count += 1
                        total_files_seen += 1
                        total_bytes_seen += size
                        local_files.append({"name": de.name, "size": size, "category": cat, "path": full})

            local_files.sort(key=lambda x: x["size"], reverse=True)
            if len(local_files) > cls.KEPT_FILES:
                node.omitted_files = len(local_files) - cls.KEPT_FILES
                node.omitted_bytes = sum(f["size"] for f in local_files[cls.KEPT_FILES:])
                node.files = local_files[:cls.KEPT_FILES]
            else:
                node.files = local_files

            for c in node.children:
                node.size += c.size
                node.item_count += c.item_count
                for i in range(len(CATEGORIES)):
                    node.cats[i] += c.cats[i]
            node.children.sort(key=lambda c: c.size, reverse=True)

        walk(root_node, root_path.startswith(("/usr", "/lib", "/etc", "/var")))
        largest = []

        def gather_largest(n: FolderNode):
            largest.extend(n.files[:30])
            for c in n.children:
                gather_largest(c)

        gather_largest(root_node)
        largest.sort(key=lambda f: f["size"], reverse=True)
        return {
            "root": root_node,
            "largest": largest[:200],
            "unreadable": unreadable_count,
            "seconds": time.monotonic() - t0,
            "cancelled": bool(cancel_event and cancel_event.is_set()),
        }


