                btn = Gtk.Button(label="Browse Raw (VOLUMA Driver)…")
                btn.connect("clicked", lambda *_, n=disk: self.open_raw_partition(n))
                btn_row.pack_end(btn, False, False, 0)
                card.pack_start(btn_row, False, False, 0)

