        def inspect_and_show_image(self, path: str):
            try:
                self.current_report = Engine.inspect_image(path)
            except Exception as e:
                self.show_error("Could not read disk image", str(e))
                return
            self.nav_list.select_row(self.nav_list.get_row_at_index(2))
            self.stack.set_visible_child_name("images")
            self.render_images_page()

        def render_images_page(self):
            for ch in self.images_container.get_children():
                self.images_container.remove(ch)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            box.set_margin_top(24)
            box.set_margin_start(24)
            box.set_margin_end(24)

            if not self.current_report:
                lbl = Gtk.Label(label="Open a raw disk image (.img, .iso) to inspect its partitions and filesystems.", xalign=0)
                btn = Gtk.Button(label="Open Disk Image…")
                btn.connect("clicked", self.on_open_image_dialog)
                box.pack_start(lbl, False, False, 0)
                box.pack_start(btn, False, False, 0)
                self.images_container.pack_start(box, True, True, 0)
                self.images_container.show_all()
                return

            r = self.current_report
            hdr = Gtk.Label(xalign=0)
            hdr.set_markup(
                f"<span size='large'><b>{GLib.markup_escape_text(os.path.basename(r['path']))}</b></span>\n"
                f"<span foreground='#888888'>{format_bytes(r['size'])} · {r['table']['kind'].upper()} · opened read-only</span>"
            )
            box.pack_start(hdr, False, False, 0)

            browsable = {"fat12", "fat16", "fat32", "ex_fat", "hfs_plus", "ext", "apfs", "ntfs"}

            wfs = r.get("whole_disk_filesystem")
            if wfs:
                box.pack_start(
                    self._image_part_row(
                        "Whole-disk Filesystem",
                        wfs.get("detail") or wfs.get("kind"),
                        wfs.get("label"),
                        None,
                        wfs.get("kind") in browsable,
                        lambda *_: self.open_image_browser(r["path"], -1, wfs.get("label") or os.path.basename(r["path"])),
                    ),
                    False,
                    False,
                    0,
                )

            for p in r.get("partitions") or []:
                fs = p.get("filesystem") or {}
                idx = p["index"]
                title = f"Partition {idx} · {p.get('type_name') or p.get('type_id')}"
                extra = f"{format_bytes(p['length'])} @ offset {p['offset']}"
                lbl = fs.get("label") or p.get("name")
                box.pack_start(
                    self._image_part_row(
                        title,
                        fs.get("detail") or fs.get("kind"),
                        lbl,
                        extra,
                        fs.get("kind") in browsable,
                        lambda *_, i=idx, l=lbl: self.open_image_browser(r["path"], i, l or f"Partition {i}"),
                    ),
                    False,
                    False,
                    0,
                )

            self.images_container.pack_start(box, True, True, 0)
            self.images_container.show_all()

        def _image_part_row(self, title, fs_name, label, extra, can_browse, on_browse):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.get_style_context().add_class("voluma-card")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            tl = Gtk.Label(xalign=0)
            tl.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
            v.pack_start(tl, False, False, 0)
            if extra:
                el = Gtk.Label(label=extra, xalign=0)
                el.set_opacity(0.7)
                v.pack_start(el, False, False, 0)
            row.pack_start(v, True, True, 0)
            if label:
                row.pack_start(Gtk.Label(label=label), False, False, 6)
            badge = Gtk.Label(label=str(fs_name))
            badge.get_style_context().add_class("voluma-badge")
            row.pack_start(badge, False, False, 6)
            if can_browse:
                b = Gtk.Button(label="Browse")
                b.connect("clicked", on_browse)
                row.pack_start(b, False, False, 0)
            return row

    win = VolumaWindow()
    win.connect("destroy", lambda *_: (HelperSessions.end_all(), Gtk.main_quit()))
    win.show_all()
    Gtk.main()


# ---------------------------------------------------------------------------
# CLI Entrypoint
# ---------------------------------------------------------------------------

def main(argv=None) -> int:
    p = argparse.ArgumentParser(
        prog="voluma",
        description="VOLUMA — Read and write NTFS, exFAT and FAT, and browse ext4, APFS and HFS+.",
    )
    p.add_argument("-V", "--version", action="store_true", help="Print version and exit")
    sub = p.add_subparsers(dest="cmd")

    p_ins = sub.add_parser("inspect", help="Inspect partitions and filesystems of a disk image or block device")
    p_ins.add_argument("image")

    p_ls = sub.add_parser("list", help="List a directory inside a disk image or partition")
    p_ls.add_argument("image")
    p_ls.add_argument("path", nargs="?", default="/")
    p_ls.add_argument("--part", type=int, default=-1)

    p_exp = sub.add_parser("export", help="Export a file from an image or partition to the host")
    p_exp.add_argument("image")
    p_exp.add_argument("fs_path")
    p_exp.add_argument("dest")
    p_exp.add_argument("--part", type=int, default=-1)

    p_mut = sub.add_parser("mutate", help="Mutate a writable filesystem (mkdir, delete, rename, import)")
    p_mut.add_argument("image")
    p_mut.add_argument("op", choices=["mkdir", "delete", "rename", "import"])
    p_mut.add_argument("a")
    p_mut.add_argument("b", nargs="?", default="")
    p_mut.add_argument("--part", type=int, default=-1)

    p_disks = sub.add_parser("disks", help="List detected Linux block devices as JSON")

    args, extra = p.parse_known_args(argv)
    if args.version:
        print(f"voluma {__version__}")
        return 0

    try:
        if args.cmd == "inspect":
            print(json.dumps(Engine.inspect_image(args.image), indent=2))
            return 0
        if args.cmd == "list":
            print(json.dumps(Engine.list_directory(args.image, args.part, args.path), indent=2))
            return 0
        if args.cmd == "export":
            print(json.dumps(Engine.export_file(args.image, args.part, args.fs_path, args.dest), indent=2))
            return 0
        if args.cmd == "mutate":
            print(json.dumps(Engine.mutate(args.image, args.part, args.op, args.a, args.b), indent=2))
            return 0
        if args.cmd == "disks":
            out = [
                {
                    "bsd": d.bsd,
                    "path": d.path,
                    "title": d.title,
                    "size": d.size,
                    "kind": d.kind_label,
                    "mount": d.mount_path,
                    "children": [
                        {
                            "bsd": c.bsd,
                            "path": c.path,
                            "title": c.title,
                            "size": c.size,
                            "kind": c.kind_label,
                            "mount": c.mount_path,
                        }
                        for c in d.children
                    ],
                }
                for d in DiskOps.snapshot()
            ]
            print(json.dumps(out, indent=2))
            return 0
    except EngineError as e:
        print(json.dumps({"error": str(e)}), file=sys.stderr)
        return 1

    img = extra[0] if extra and os.path.exists(extra[0]) else None
    run_gui(img)
    return 0


if __name__ == "__main__":
    sys.exit(main())
