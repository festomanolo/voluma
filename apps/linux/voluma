class FSBackend:
    id: str = ""
    is_native: bool = False

    def list(self, path: str) -> dict:
        raise NotImplementedError

    def host_path(self, path: str):
        return None

    def export_file(self, path: str, dest: Path):
        raise NotImplementedError

    def import_file(self, host: Path, path: str):
        raise NotImplementedError

    def mkdir(self, path: str):
        raise NotImplementedError

    def delete(self, path: str):
        raise NotImplementedError

    def rename(self, a: str, b: str):
        raise NotImplementedError


class EngineBackend(FSBackend):
    def __init__(self, image: str, part: int = -1):
        self.image = image
        self.part = part
        self.id = f"img:{image}:{part}"
        self.is_native = False

    def list(self, path: str) -> dict:
        return Engine.list_directory(self.image, self.part, path)

    def export_file(self, path: str, dest: Path):
        Engine.export_file(self.image, self.part, path, str(dest))

    def import_file(self, host: Path, path: str):
        Engine.mutate(self.image, self.part, "import", path, str(host), False)

    def mkdir(self, path: str):
        Engine.mutate(self.image, self.part, "mkdir", path)

    def delete(self, path: str):
        Engine.mutate(self.image, self.part, "delete", path)

    def rename(self, a: str, b: str):
        Engine.mutate(self.image, self.part, "rename", a, b)


class HelperBackend(FSBackend):
    def __init__(self, session: HelperSession, part: int = -1):
        self.session = session
        self.part = part
        self.id = f"helper:{session.device}:{part}"
        self.is_native = False

    def list(self, path: str) -> dict:
        return self.session.call_ok({"op": "list", "part": self.part, "path": path})

    def export_file(self, path: str, dest: Path):
        name = f"out-{uuid.uuid4().hex[:12]}"
        self.session.call_ok({"op": "export", "part": self.part, "path": path, "dst": name})
        staged = self.session.stage / name
        try:
            shutil.move(str(staged), str(dest))
        finally:
            if staged.exists():
                staged.unlink()

    def import_file(self, host: Path, path: str):
        name = f"in-{uuid.uuid4().hex[:12]}"
        staged = self.session.stage / name
        shutil.copyfile(str(host), str(staged))
        try:
            self.session.call_ok({"op": "import", "part": self.part, "src": name, "path": path})
        finally:
            if staged.exists():
                staged.unlink()

    def mkdir(self, path: str):
        self.session.call_ok({"op": "mkdir", "part": self.part, "path": path})

    def delete(self, path: str):
        self.session.call_ok({"op": "delete", "part": self.part, "path": path})

    def rename(self, a: str, b: str):
        self.session.call_ok({"op": "rename", "part": self.part, "path": a, "to": b})


class NativeBackend(FSBackend):
    def __init__(self, root: str):
        self.root = root
        self.id = f"vol:{root}"
        self.is_native = True

    def _full(self, p: str) -> Path:
        if not p or p == "/":
            return Path(self.root)
        return Path(self.root) / p.lstrip("/")

    def host_path(self, path: str) -> Path:
        return self._full(path)

    def list(self, p: str) -> dict:
        target = self._full(p)
        entries = []
        with os.scandir(str(target)) as it:
            for de in it:
                try:
                    st = de.stat(follow_symlinks=False)
                    is_dir = stat.S_ISDIR(st.st_mode)
                    entries.append({
                        "name": de.name,
                        "kind": "directory" if is_dir else "file",
                        "size": 0 if is_dir else int(st.st_size),
                        "modified": int(st.st_mtime),
                        "hidden": de.name.startswith("."),
                    })
                except OSError:
                    continue
        entries.sort(key=lambda e: (e["kind"] != "directory", e["name"].lower()))
        return {
            "filesystem": "Mounted volume",
            "label": None,
            "entries": entries,
            "capabilities": {"read": True, "write": True},
            "driver_supports_write": True,
            "write_blocked": None,
        }

    def export_file(self, path: str, dest: Path):
        if dest.exists():
            raise EngineError(f"Destination already exists: {dest}")
        shutil.copy2(str(self._full(path)), str(dest))

    def import_file(self, host: Path, path: str):
        dst = self._full(path)
        if dst.exists():
            raise EngineError(f"Target already exists: {dst}")
        shutil.copy2(str(host), str(dst))

    def mkdir(self, path: str):
        self._full(path).mkdir(parents=False, exist_ok=False)

    def delete(self, path: str):
        full = self._full(path)
        if shutil.which("gio"):
            rc = subprocess.call(["gio", "trash", str(full)])
            if rc == 0:
                return
        # Fallback to XDG Trash
        trash = Path.home() / ".local" / "share" / "Trash" / "files"
        trash.mkdir(parents=True, exist_ok=True)
        dest = trash / f"{full.name}.{uuid.uuid4().hex[:6]}"
        shutil.move(str(full), str(dest))

    def rename(self, a: str, b: str):
        dst = self._full(b)
        if dst.exists():
            raise EngineError(f"Target already exists: {dst}")
        self._full(a).rename(dst)


class Copier:
    @staticmethod
    def unique_name(name: str, taken: set) -> str:
        if name.lower() not in taken:
            return name
        p = Path(name)
        stem = p.stem if p.suffix else name
        ext = p.suffix
        n = 1
        while True:
            cand = (f"{stem} copy" if n == 1 else f"{stem} copy {n}") + ext
            if cand.lower() not in taken:
                return cand
            n += 1

    @staticmethod
    def taken_names(backend: FSBackend, dir_path: str) -> set:
        try:
            listing = backend.list(dir_path)
            return {e["name"].lower() for e in listing.get("entries", [])}
        except Exception:
            return set()

    @classmethod
    def copy_entry(cls, src: FSBackend, src_path: str, entry: dict, dst: FSBackend, dst_dir: str, taken: set, progress=None) -> int:
        is_dir = entry.get("kind") == "directory"
        if src.id == dst.id and is_dir and (dst_dir == src_path or dst_dir.startswith(src_path.rstrip("/") + "/")):
            raise EngineError(f"Cannot copy '{entry['name']}' into itself")
        name = cls.unique_name(entry["name"], taken)
        taken.add(name.lower())
        dpath = join_path(dst_dir, name)
        if progress:
            progress(entry["name"])
        if is_dir:
            dst.mkdir(dpath)
            inner = set()
            count = 1
            for child in src.list(src_path).get("entries", []):
                count += cls.copy_entry(src, join_path(src_path, child["name"]), child, dst, dpath, inner, progress)
            return count
        host_src = src.host_path(src_path)
        if host_src is not None:
            dst.import_file(host_src, dpath)
            return 1
        tmp = Path(tempfile.gettempdir()) / f"voluma-copy-{uuid.uuid4().hex}"
        try:
            src.export_file(src_path, tmp)
            dst.import_file(tmp, dpath)
        finally:
            if tmp.exists():
                tmp.unlink()
        return 1

    @classmethod
    def copy_host(cls, host_path: Path, dst: FSBackend, dst_dir: str, taken: set, progress=None) -> int:
        name = cls.unique_name(host_path.name, taken)
        taken.add(name.lower())
        dpath = join_path(dst_dir, name)
        if progress:
            progress(host_path.name)
        if host_path.is_dir():
            dst.mkdir(dpath)
            inner = set()
            count = 1
            for child in sorted(host_path.iterdir(), key=lambda p: p.name.lower()):
                count += cls.copy_host(child, dst, dpath, inner, progress)
            return count
        dst.import_file(host_path, dpath)
        return 1


# ---------------------------------------------------------------------------
# Linux Disk Discovery & Mount/Eject Operations
# ---------------------------------------------------------------------------

class DiskNode:
    def __init__(self, **kw):
        self.bsd = kw.get("bsd", "")
        self.path = kw.get("path", f"/dev/{self.bsd}")
        self.is_whole = kw.get("is_whole", False)
        self.size = int(kw.get("size") or 0)
        self.fs_kind = (kw.get("fs_kind") or "").lower()
        self.label = kw.get("label") or ""
        self.mount_path = kw.get("mount_path")
        self.model = (kw.get("model") or "").strip()
        self.bus_protocol = (kw.get("bus_protocol") or "").upper()
        self.removable = bool(kw.get("removable", False))
        self.writable = not bool(kw.get("ro", False))
        self.is_disk_image = kw.get("type") == "loop"
        self.total = kw.get("total")
        self.free = kw.get("free")
        self.children = kw.get("children") or []
        self.read_only_mount = bool(kw.get("read_only_mount", False))

    @property
    def is_mounted(self) -> bool:
        return bool(self.mount_path)

    @property
    def raw_browsable(self) -> bool:
        if self.is_mounted or self.children or self.size < (1 << 20):
            return False
        if self.fs_kind in ("swap", "squashfs", "crypto_luks"):
            return False
        return True

    @property
    def title(self) -> str:
        if self.label:
            return self.label
        if self.is_whole:
            return self.model or f"Disk {self.bsd}"
        if self.mount_path == "/":
            return "Light OS Root"
        return f"Partition {self.bsd}"

    @property
    def kind_label(self) -> str:
        mapping = {
            "vfat": "FAT",
            "fat32": "FAT32",
            "fat16": "FAT16",
            "fat12": "FAT12",
            "msdos": "FAT",
            "exfat": "exFAT",
            "ntfs": "NTFS",
            "ext4": "ext4",
            "ext3": "ext3",
            "ext2": "ext2",
            "apfs": "APFS",
            "hfsplus": "HFS+",
            "iso9660": "ISO 9660",
            "xfs": "XFS",
            "btrfs": "Btrfs",
        }
        if self.fs_kind:
            return mapping.get(self.fs_kind, self.fs_kind.upper())
        return "Disk" if self.is_whole else "Partition"


class DiskOps:
    @staticmethod
    def snapshot() -> list:
        try:
            out = subprocess.check_output(
                [
                    "lsblk",
                    "-J",
                    "-b",
                    "-o",
                    "NAME,KNAME,PATH,TYPE,SIZE,FSTYPE,LABEL,MOUNTPOINT,MODEL,TRAN,RM,RO",
                ],
                stderr=subprocess.DEVNULL,
            ).decode("utf-8", errors="replace")
            data = json.loads(out)
        except Exception:
            return []

        ro_mounts = set()
        try:
            with open("/proc/mounts", "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 4:
                        mp = parts[1]
                        opts = parts[3].split(",")
                        if "ro" in opts:
                            ro_mounts.add(mp)
        except Exception:
            pass

        def build_node(item: dict, is_root: bool = False) -> DiskNode:
            kname = item.get("kname") or item.get("name") or ""
            dev_path = item.get("path") or f"/dev/{kname}"
            mp = item.get("mountpoint")
            # Ignore internal squashfs loop mounts from Porteus/Light OS base modules
            if item.get("type") == "loop" and (item.get("fstype") == "squashfs" or (mp and mp.startswith("/mnt/live"))):
                return None
            total = None
            free = None
            ro_mnt = False
            if mp and os.path.isdir(mp):
                try:
                    sv = os.statvfs(mp)
                    total = int(sv.f_blocks * sv.f_frsize)
                    free = int(sv.f_bavail * sv.f_frsize)
                    ro_mnt = mp in ro_mounts or bool(sv.f_flag & getattr(os, "ST_RDONLY", 1))
                except OSError:
                    pass
            kids = []
            for ch in item.get("children") or []:
                cn = build_node(ch, False)
                if cn is not None:
                    kids.append(cn)
            return DiskNode(
                bsd=kname,
                path=dev_path,
                is_whole=is_root,
                size=int(item.get("size") or 0),
                fs_kind=item.get("fstype") or "",
                label=item.get("label") or "",
                mount_path=mp,
                model=item.get("model") or "",
                bus_protocol=item.get("tran") or "",
                removable=bool(item.get("rm")),
                ro=bool(item.get("ro")),
                type=item.get("type") or "",
                total=total,
                free=free,
                read_only_mount=ro_mnt,
                children=kids,
            )

        disks = []
        for dev in data.get("blockdevices") or []:
            if dev.get("type") in ("ram", "zram", "rom"):
                continue
            node = build_node(dev, True)
            if node is not None and (node.size > 0 or node.children):
                disks.append(node)
        return disks

    @staticmethod
    def unmount(device: str):
        for cmd in (["udisksctl", "unmount", "-b", device], ["umount", device]):
            if shutil.which(cmd[0]):
                p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                if p.returncode == 0:
                    return None
                last_err = (p.stderr or p.stdout).strip()
        return last_err if "last_err" in locals() else "unmount failed"

    @staticmethod
    def mount(device: str):
        if shutil.which("udisksctl"):
            p = subprocess.run(["udisksctl", "mount", "-b", device], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if p.returncode == 0:
                return None
            return (p.stderr or p.stdout).strip()
        return None


