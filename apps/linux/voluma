        # Browser View
        # -------------------------------------------------------------------
        def open_mounted_volume(self, node: DiskNode):
            self.current_browser = {
                "title": node.title,
                "backend": NativeBackend(node.mount_path),
                "path": "/",
                "back_stack": [],
                "forward_stack": [],
                "is_native": True,
                "via_helper": False,
                "device": node.path,
                "fs_kind": node.fs_kind,
                "read_only_mount": node.read_only_mount,
                "write_unlocked": False,
                "origin": "disks",
            }
            self.stack.set_visible_child_name("browser")
            self.load_browser_dir()

        def open_raw_partition(self, node: DiskNode):
            try:
                sess = HelperSessions.start(node.path, node.title, mounted=False, check_write=False)
            except Exception as e:
                self.show_error("Could not open partition", str(e))
                return
            self.current_browser = {
                "title": node.title,
                "backend": HelperBackend(sess, -1),
                "path": "/",
                "back_stack": [],
                "forward_stack": [],
                "is_native": False,
                "via_helper": True,
                "raw_only": True,
                "device": node.path,
                "fs_kind": node.fs_kind,
                "read_only_mount": False,
                "write_unlocked": False,
                "origin": "disks",
