            status_lbl.set_opacity(0.75)
            sbar.pack_start(status_lbl, True, True, 0)

            exp_btn = Gtk.Button(label="Export Selected…")
            exp_btn.connect("clicked", self._on_export_selected)
            sbar.pack_end(exp_btn, False, False, 0)

            if can_write:
                del_btn = Gtk.Button(label="Move to Trash" if b["is_native"] else "Delete")
                del_btn.connect("clicked", self._on_delete_selected)
                sbar.pack_end(del_btn, False, False, 0)

                ren_btn = Gtk.Button(label="Rename…")
                ren_btn.connect("clicked", self._on_rename_selected)
                sbar.pack_end(ren_btn, False, False, 0)

            self.browser_container.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)
            self.browser_container.pack_start(sbar, False, False, 0)
            self.browser_container.show_all()

        def _browser_go(self, new_path: str):
            b = self.current_browser
            if not b or new_path == b["path"]:
                return
            b["back_stack"].append(b["path"])
            b["forward_stack"].clear()
            b["path"] = new_path
            self.load_browser_dir()

        def _selected_entries(self) -> list:
            b = self.current_browser
            if not b or "treeview" not in b:
                return []
            model, paths = b["treeview"].get_selection().get_selected_rows()
            return [model[p][4] for p in paths]

        def _on_browser_row_activated(self, tv, path, col):
            model = tv.get_model()
            entry = model[path][4]
            b = self.current_browser
            if entry.get("kind") == "directory":
                self._browser_go(join_path(b["path"], entry["name"]))
            elif b["is_native"]:
                hp = b["backend"].host_path(join_path(b["path"], entry["name"]))
                if hp:
                    subprocess.Popen(["xdg-open", str(hp)])
            else:
                self._export_entry(entry)

        def _toggle_image_writable(self, *_):
            b = self.current_browser
            if not b:
                return
            if b["write_unlocked"]:
                b["write_unlocked"] = False
            else:
                if self.ask_confirm(
                    "Allow changes to this disk image?",
                    "VOLUMA will modify the disk image file directly. Volumes that were not cleanly unmounted are refused.",
                    "Allow Changes",
                ):
                    b["write_unlocked"] = True
            self.load_browser_dir()

        def _on_copy_selected(self, *_):
            b = self.current_browser
            es = self._selected_entries()
            if not b or not es:
                return
            self.clip_backend = b["backend"]
            self.clip_items = [(join_path(b["path"], e["name"]), e) for e in es]
            b["status"] = f"Copied {len(es)} item{'' if len(es) == 1 else 's'}"
            self.load_browser_dir()

        def _on_paste(self, *_):
            b = self.current_browser
            if not b or not b.get("can_write") or not self.clip_items:
                return
            taken = Copier.taken_names(b["backend"], b["path"])
            count = 0
            try:
                for src_path, entry in self.clip_items:
                    count += Copier.copy_entry(self.clip_backend, src_path, entry, b["backend"], b["path"], taken)
                b["status"] = f"Pasted {count} item{'' if count == 1 else 's'}"
            except Exception as e:
                self.show_error("Paste failed", str(e))
            self.load_browser_dir()

        def _on_new_folder(self, *_):
            b = self.current_browser
            if not b or not b.get("can_write"):
                return
            dlg = Gtk.Dialog(title="New Folder", transient_for=self, flags=0)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Create", Gtk.ResponseType.OK)
            entry = Gtk.Entry(placeholder_text="Folder name")
            entry.set_margin_top(12)
            entry.set_margin_bottom(12)
            entry.set_margin_start(12)
            entry.set_margin_end(12)
            dlg.get_content_area().add(entry)
            dlg.show_all()
            if dlg.run() == Gtk.ResponseType.OK:
                name = entry.get_text().strip()
                if name:
                    try:
                        b["backend"].mkdir(join_path(b["path"], name))
                        b["status"] = f"Created {name}"
                    except Exception as e:
                        self.show_error("Create Folder Failed", str(e))
            dlg.destroy()
            self.load_browser_dir()

        def _on_rename_selected(self, *_):
            b = self.current_browser
            es = self._selected_entries()
            if not b or len(es) != 1:
                return
            target_e = es[0]
            dlg = Gtk.Dialog(title="Rename", transient_for=self, flags=0)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Rename", Gtk.ResponseType.OK)
            entry = Gtk.Entry(text=target_e["name"])
            entry.set_margin_top(12)
            entry.set_margin_bottom(12)
            entry.set_margin_start(12)
            entry.set_margin_end(12)
            dlg.get_content_area().add(entry)
            dlg.show_all()
            if dlg.run() == Gtk.ResponseType.OK:
                new_name = entry.get_text().strip()
                if new_name and new_name != target_e["name"]:
                    try:
                        b["backend"].rename(join_path(b["path"], target_e["name"]), join_path(b["path"], new_name))
                        b["status"] = f"Renamed to {new_name}"
                    except Exception as e:
                        self.show_error("Rename Failed", str(e))
            dlg.destroy()
            self.load_browser_dir()

        def _on_delete_selected(self, *_):
            b = self.current_browser
            es = self._selected_entries()
            if not b or not es:
                return
            action = "Move to Trash" if b["is_native"] else "Permanently delete"
            if not self.ask_confirm(
                f"{action} {len(es)} item{'' if len(es) == 1 else 's'}?",
                "Items on mounted volumes go to the Trash. Items inside raw images/volumes are deleted immediately.",
                action,
            ):
                return
            try:
                for e in es:
                    b["backend"].delete(join_path(b["path"], e["name"]))
                b["status"] = f"Deleted {len(es)} item{'' if len(es) == 1 else 's'}"
            except Exception as e:
                self.show_error("Delete Failed", str(e))
            self.load_browser_dir()

        def _on_import_files(self, *_):
            b = self.current_browser
            if not b or not b.get("can_write"):
                return
            dlg = Gtk.FileChooserDialog(
                title="Import Files into Volume",
                parent=self,
                action=Gtk.FileChooserAction.OPEN,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Import", Gtk.ResponseType.OK)
            dlg.set_select_multiple(True)
            if dlg.run() == Gtk.ResponseType.OK:
                files = [Path(f) for f in dlg.get_filenames()]
                taken = Copier.taken_names(b["backend"], b["path"])
                try:
                    n = 0
                    for f in files:
                        n += Copier.copy_host(f, b["backend"], b["path"], taken)
                    b["status"] = f"Imported {n} item{'' if n == 1 else 's'}"
                except Exception as e:
                    self.show_error("Import Failed", str(e))
            dlg.destroy()
            self.load_browser_dir()

        def _on_export_selected(self, *_):
            es = self._selected_entries()
            if len(es) == 1:
                self._export_entry(es[0])

        def _export_entry(self, entry: dict):
            b = self.current_browser
            if not b or entry.get("kind") == "directory":
                return
            dlg = Gtk.FileChooserDialog(
                title="Export File",
                parent=self,
                action=Gtk.FileChooserAction.SAVE,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Export", Gtk.ResponseType.OK)
            dlg.set_current_name(entry["name"])
            dlg.set_do_overwrite_confirmation(True)
            if dlg.run() == Gtk.ResponseType.OK:
                dest = Path(dlg.get_filename())
                if dest.exists():
                    dest.unlink()
                try:
                    b["backend"].export_file(join_path(b["path"], entry["name"]), dest)
                    b["status"] = f"Exported {entry['name']} ({format_bytes(entry.get('size', 0))})"
                except Exception as e:
                    self.show_error("Export Failed", str(e))
            dlg.destroy()
            self.load_browser_dir()

        # -------------------------------------------------------------------
        # Storage Lens View
        # -------------------------------------------------------------------
        def start_lens_scan(self, path: str, title: str):
            self.nav_list.select_row(self.nav_list.get_row_at_index(1))
            self.stack.set_visible_child_name("lens")
            if self.lens_cancel:
                self.lens_cancel.set()
            cancel_ev = threading.Event()
            self.lens_cancel = cancel_ev

            for ch in self.lens_container.get_children():
                self.lens_container.remove(ch)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            box.set_valign(Gtk.Align.CENTER)
            box.set_halign(Gtk.Align.CENTER)
            sp = Gtk.Spinner()
            sp.start()
            lbl = Gtk.Label(label=f"Scanning {title} ({path})…")
            sub = Gtk.Label(label="0 files")
            box.pack_start(sp, False, False, 0)
            box.pack_start(lbl, False, False, 0)
            box.pack_start(sub, False, False, 0)
            self.lens_container.pack_start(box, True, True, 0)
            self.lens_container.show_all()

            def prog(files, bytes_seen, cur):
                GLib.idle_add(lambda: sub.set_text(f"{files:,} files · {format_bytes(bytes_seen)}"))

            def worker():
                res = StorageScanner.scan(path, cancel_ev, prog)
                res["title"] = title
                def done():
                    self.lens_result = res
                    self.lens_current = res["root"]
                    self.render_lens_page()
                GLib.idle_add(done)

            threading.Thread(target=worker, daemon=True).start()

        def render_lens_page(self):
            for ch in self.lens_container.get_children():
                self.lens_container.remove(ch)

            if not self.lens_result or not self.lens_current:
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
                box.set_margin_top(24)
                box.set_margin_start(24)
                box.set_margin_end(24)
                hdr = Gtk.Label(xalign=0)
                hdr.set_markup("<span size='large'><b>Storage Lens — Choose a volume or folder to analyse</b></span>")
                box.pack_start(hdr, False, False, 0)
                for d in self.disks:
                    nodes = [d] + d.children
                    for n in nodes:
                        if n.is_mounted:
                            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                            row.get_style_context().add_class("voluma-card")
                            row.pack_start(Gtk.Label(label=f"{n.title} ({n.mount_path})", xalign=0), True, True, 0)
                            btn = Gtk.Button(label="Scan")
                            btn.connect("clicked", lambda *_, m=n.mount_path, t=n.title: self.start_lens_scan(m, t))
                            row.pack_end(btn, False, False, 0)
                            box.pack_start(row, False, False, 0)

                choose_btn = Gtk.Button(label="Choose Folder…")
                choose_btn.connect("clicked", self._on_choose_lens_folder)
                box.pack_start(choose_btn, False, False, 0)
                self.lens_container.pack_start(box, True, True, 0)
                self.lens_container.show_all()
                return

            cur = self.lens_current
            res = self.lens_result

            top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            top.set_margin_top(16)
            top.set_margin_bottom(12)
            top.set_margin_start(16)
            top.set_margin_end(16)

            hrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            if cur.parent is not None:
                up_btn = Gtk.Button(label="← Up")
                up_btn.connect("clicked", lambda *_: self._set_lens_node(cur.parent))
                hrow.pack_start(up_btn, False, False, 0)
            tlbl = Gtk.Label(xalign=0)
            tlbl.set_markup(f"<span size='large'><b>{GLib.markup_escape_text(cur.name)}</b></span> — {format_bytes(cur.size)} ({cur.item_count:,} files in {res['seconds']:.1f}s)")
            hrow.pack_start(tlbl, True, True, 0)

            new_btn = Gtk.Button(label="New Scan")
            new_btn.connect("clicked", lambda *_: self._reset_lens())
            hrow.pack_end(new_btn, False, False, 0)
            top.pack_start(hrow, False, False, 0)

            # Category breakdown summary
            cat_parts = []
            for i, (cname, color) in enumerate(CATEGORIES):
                if cur.cats[i] > 0:
                    cat_parts.append(f"<span foreground='{color}'>●</span> {cname}: <b>{format_bytes(cur.cats[i])}</b>")
            cat_lbl = Gtk.Label(xalign=0)
            cat_lbl.set_line_wrap(True)
            cat_lbl.set_markup("   ".join(cat_parts) if cat_parts else "Empty")
            top.pack_start(cat_lbl, False, False, 0)
            self.lens_container.pack_start(top, False, False, 0)
            self.lens_container.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

            store = Gtk.ListStore(str, str, str, object)
            for c in cur.children:
                pct = (100.0 * c.size / cur.size) if cur.size > 0 else 0.0
                store.append([f"📁 {c.name}", f"{pct:.1f}%", format_bytes(c.size), c])
            for f in cur.files:
                pct = (100.0 * f["size"] / cur.size) if cur.size > 0 else 0.0
                store.append([f"📄 {f['name']}", f"{pct:.1f}%", format_bytes(f["size"]), None])

            tv = Gtk.TreeView(model=store)
            for idx, title, expand in [(0, "Name", True), (1, "Share", False), (2, "Size", False)]:
                r = Gtk.CellRendererText()
                col = Gtk.TreeViewColumn(title, r, text=idx)
                col.set_expand(expand)
                tv.append_column(col)

            def on_row(tree, path, col):
                node = tree.get_model()[path][3]
                if node is not None:
                    self._set_lens_node(node)

            tv.connect("row-activated", on_row)
            sc = Gtk.ScrolledWindow()
            sc.add(tv)
            self.lens_container.pack_start(sc, True, True, 0)
            self.lens_container.show_all()

        def _set_lens_node(self, node: FolderNode):
            self.lens_current = node
            self.render_lens_page()

        def _reset_lens(self):
            self.lens_result = None
            self.lens_current = None
            self.render_lens_page()

        def _on_choose_lens_folder(self, *_):
            dlg = Gtk.FileChooserDialog(
                title="Choose Folder to Scan",
                parent=self,
                action=Gtk.FileChooserAction.SELECT_FOLDER,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Scan", Gtk.ResponseType.OK)
            if dlg.run() == Gtk.ResponseType.OK:
                folder = dlg.get_filename()
                dlg.destroy()
                if folder:
                    self.start_lens_scan(folder, os.path.basename(folder) or folder)
            else:
                dlg.destroy()

