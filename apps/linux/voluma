                tbar.pack_end(paste_btn, False, False, 0)

            copy_btn = Gtk.Button(label="Copy")
            copy_btn.connect("clicked", self._on_copy_selected)
            tbar.pack_end(copy_btn, False, False, 0)

            self.browser_container.pack_start(tbar, False, False, 0)
            self.browser_container.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

            # NTFS / Read-only mount banner or Helper banner
