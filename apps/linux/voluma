                lock_btn.connect("clicked", self._toggle_image_writable)
                tbar.pack_end(lock_btn, False, False, 0)

            if can_write:
                imp_btn = Gtk.Button(label="Import…")
                imp_btn.connect("clicked", self._on_import_files)
                tbar.pack_end(imp_btn, False, False, 0)

                mkdir_btn = Gtk.Button(label="New Folder")
                mkdir_btn.connect("clicked", self._on_new_folder)
                tbar.pack_end(mkdir_btn, False, False, 0)

                paste_btn = Gtk.Button(label="Paste")
