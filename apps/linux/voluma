                banner.get_style_context().add_class("voluma-banner-warn")
                banner.pack_start(
                    Gtk.Label(label="This volume is mounted read-only. Enable VOLUMA's raw driver to write.", xalign=0),
                    True,
                    True,
                    0,
                )
                en_btn = Gtk.Button(label="Enable Writing…")
                en_btn.connect("clicked", lambda *_: self.enable_helper_writing())
                banner.pack_end(en_btn, False, False, 0)
                self.browser_container.pack_start(banner, False, False, 0)
            elif b["via_helper"]:
                banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                banner.get_style_context().add_class("voluma-banner-ok")
