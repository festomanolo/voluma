            tv.connect("row-activated", self._on_browser_row_activated)
            b["treeview"] = tv

            col_name = Gtk.TreeViewColumn("Name")
            cell_pix = Gtk.CellRendererPixbuf()
            cell_txt = Gtk.CellRendererText()
            col_name.pack_start(cell_pix, False)
            col_name.pack_start(cell_txt, True)
            col_name.add_attribute(cell_pix, "icon-name", 0)
            col_name.add_attribute(cell_txt, "text", 1)
            col_name.set_expand(True)
            tv.append_column(col_name)

            for idx, title, width in [(2, "Size", 110), (3, "Modified", 160)]:
