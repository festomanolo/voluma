        def on_open_image_dialog(self, *_):
            dlg = Gtk.FileChooserDialog(
                title="Open Disk Image",
                parent=self,
                action=Gtk.FileChooserAction.OPEN,
            )
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
