            top.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)

            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t_lbl = Gtk.Label(xalign=0)
            t_lbl.set_markup(f"<b>{GLib.markup_escape_text(disk.title)}</b>")
            sub_parts = [disk.path]
            if disk.bus_protocol:
                sub_parts.append(disk.bus_protocol)
            sub_parts.append("Removable" if disk.removable else "Internal")
            if not disk.writable:
                sub_parts.append("Read-only media")
