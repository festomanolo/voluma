        def enable_helper_writing(self):
            b = self.current_browser
            if not b or not b.get("device"):
                return
            if not self.ask_confirm(
                f"Enable writing to '{b['title']}'?",
                "VOLUMA will unmount the volume from Linux, start its privileged helper, and write directly with VOLUMA's driver (refusing dirty or hibernated volumes).",
                "Unmount & Enable Writing",
            ):
                return
            try:
                sess = HelperSessions.start(b["device"], b["title"], mounted=True, check_write=True)
            except Exception as e:
                self.show_error("Could not enable writing", str(e))
                return
            b["backend"] = HelperBackend(sess, -1)
            b["is_native"] = False
            b["via_helper"] = True
            b["raw_only"] = False
            b["read_only_mount"] = False
            self.load_browser_dir()

        def load_browser_dir(self):
            b = self.current_browser
            if not b:
                return
            self.back_btn.set_sensitive(True)
            for ch in self.browser_container.get_children():
                self.browser_container.remove(ch)

            try:
                listing = b["backend"].list(b["path"])
                b["listing"] = listing
                err_msg = None
            except Exception as e:
                listing = None
                err_msg = str(e)

            driver_writable = bool(listing and listing.get("driver_supports_write"))
            write_blocked = listing.get("write_blocked") if listing else None
            can_write = (
                (b["is_native"] and not b["read_only_mount"])
                or (b["via_helper"] and driver_writable and not write_blocked)
                or (not b["is_native"] and not b["via_helper"] and b["write_unlocked"] and driver_writable and not write_blocked)
            )
            b["can_write"] = can_write

            # Toolbar
            tbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            tbar.set_margin_top(8)
            tbar.set_margin_bottom(8)
            tbar.set_margin_start(14)
            tbar.set_margin_end(14)

            root_btn = Gtk.Button(label=b["title"])
            root_btn.connect("clicked", lambda *_: self._browser_go("/"))
            tbar.pack_start(root_btn, False, False, 0)

            crumbs = [c for c in b["path"].split("/") if c]
            for i, c in enumerate(crumbs):
                tbar.pack_start(Gtk.Label(label="›"), False, False, 2)
                target_p = "/" + "/".join(crumbs[: i + 1])
                cb = Gtk.Button(label=c)
                cb.connect("clicked", lambda *_, p=target_p: self._browser_go(p))
